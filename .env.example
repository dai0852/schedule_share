# Microsoft Entra / Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_MICROSOFT_TENANT_ID=

# Google Calendar OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Server-side Firebase Admin
FIREBASE_PROJECT_ID=
# Use this JSON path, or set FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY below.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Access control
ALLOWED_EMAIL_DOMAINS=example.co.jp
ADMIN_EMAILS=
DEFAULT_USER_ROLE=viewer
# Enable only for an intentional local demo. Keep false for real authentication.
ALLOW_DEMO_AUTH=false
USE_FIRESTORE=false
