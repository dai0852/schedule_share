# Browser-safe Firebase / Microsoft sign-in config.
# NEXT_PUBLIC_ values are shipped to the browser; never put secrets in them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_MICROSOFT_TENANT_ID=

# Server-only Microsoft Graph sync app. Prefer a separate Entra app from Firebase sign-in.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Server-only Google Calendar OAuth and refresh-token encryption.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Server-only shared secret for POST /api/internal/sync/calendars.
# Use 32-256 printable ASCII characters without a comma; store it in Secret Manager.
SYNC_JOB_SECRET=

# Firebase Admin runtime.
# App Hosting production: set only FIREBASE_PROJECT_ID and use its managed ADC service account.
FIREBASE_PROJECT_ID=
# Preferred local development: absolute path to a service-account JSON stored outside the repository.
# Keep the JSON Git-ignored and owner-readable only. The Admin SDK reads this path as ADC.
GOOGLE_APPLICATION_CREDENTIALS=
# Local fallback only: set both fields together in .env.local; never set only one.
# FIREBASE_PRIVATE_KEY must be one double-quoted line whose line breaks are literal \n text.
# Never paste the real key into Git, docs, chat, screenshots, or shell history.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-side access control and persistence.
ALLOWED_EMAIL_DOMAINS=
ADMIN_EMAILS=
DEFAULT_USER_ROLE=viewer
# Production values. Enable demo auth only for an intentional non-production local demo.
ALLOW_DEMO_AUTH=false
USE_FIRESTORE=true
